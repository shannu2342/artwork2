PORT=5000

# Option 1: full URL
# MYSQL_URL=mysql://root:password@127.0.0.1:3306/limitless_art

# Option 2: discrete fields
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=limitless_art

# Admin Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow_123!
# Optional pre-hashed password (bcrypt). If set, this is used instead of ADMIN_PASSWORD on first bootstrap.
# ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN_EXPIRES=12h

UPLOAD_MAX_WIDTH=1920
UPLOAD_MAX_HEIGHT=1920
UPLOAD_WEBP_QUALITY=82
